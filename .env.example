# Hivemind environment template.
# Copy to `.env` and fill in. `.env` is gitignored by the scaffold's .gitignore.
#
# Push to the deployed Worker:
#   ntn workers env push

# ── Notion ───────────────────────────────────────────────────────────────────
# Internal integration token. Create one at:
#   https://www.notion.so/profile/integrations/internal
# Then in Notion, share the Briefs database (and any page Hivemind touches)
# with the integration via "..." → Connections → <your integration name>.
NOTION_API_TOKEN=

# ── Anthropic ────────────────────────────────────────────────────────────────
# Create at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ── OpenAI ───────────────────────────────────────────────────────────────────
# Used by the Sentinel agent (GPT-5). Create at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ── Hivemind config ──────────────────────────────────────────────────────────
# Briefs database ID — populated after the database is created in Notion.
# Get the ID from the database URL: notion.so/<space>/<DB_ID>?v=...
HIVEMIND_BRIEFS_DATABASE_ID=

# Shared secret you put in the Notion automation's webhook "Headers" field as
# `X-Hivemind-Secret: <this>`. The Worker verifies this on every incoming POST.
HIVEMIND_WEBHOOK_SECRET=

# Auto-discovered data source ID for the Briefs DB.
# Find it with: ntn datasources resolve $HIVEMIND_BRIEFS_DATABASE_ID
HIVEMIND_BRIEFS_DATA_SOURCE_ID=

# Bot user ID for your Notion integration. Used by onBriefStatusChange to skip
# bot-authored edits (loop prevention). Get with:
#   curl https://api.notion.com/v1/users/me \
#     -H "Authorization: Bearer $NOTION_API_TOKEN" \
#     -H "Notion-Version: 2022-06-28"
HIVEMIND_BOT_USER_ID=

# ── Anvil dispatch (Worker → local daemon) ───────────────────────────────────
# Pusher Channels (https://pusher.com/channels) — the Worker publishes
# `brief.dispatched` events on PUSHER_CHANNEL when a brief gets
# Owner=Forge-Local, and Anvil subscribes from the user's machine.
# The free tier (200k msgs/day, 100 concurrent connections) is enough.
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=
PUSHER_CHANNEL=anvil-dispatch

# ── Anvil (local daemon — read by anvil/, NOT the Worker) ────────────────────
# VM backend. "lima" (default) runs a local Lima VM on your Mac
# (brew install lima first). "e2b" runs cloud Firecracker microVMs at e2b.dev
# (set E2B_API_KEY below).
# SANDBOX_DRIVER=lima

# Only needed when SANDBOX_DRIVER=e2b. Sign up + create an API key:
# https://e2b.dev/dashboard
# E2B_API_KEY=

# GitHub fine-grained PAT with Contents R/W, Pull requests R/W, Metadata R.
# https://github.com/settings/personal-access-tokens
GITHUB_PAT=
# Optional: GitHub org under which Anvil scaffolds new repos. Leave blank to
# put new repos on the PAT owner's personal account.
GITHUB_DEFAULT_ORG=

# Optional Anvil overrides (defaults are fine for local use):
# FORGE_LOCAL_MODEL=claude-sonnet-4-5-20250929
# ANVIL_WORKDIR_ROOT=$HOME/.anvil
# MOCK_MODE=false
# LOG_LEVEL=info
