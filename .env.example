# Hivemind environment template.
# Copy to `.env` and fill in. `.env` is gitignored by the scaffold's .gitignore.
#
# Push to the deployed Worker:
#   ntn workers env push

# ── Notion ───────────────────────────────────────────────────────────────────
# Internal integration token. Create one at:
#   https://www.notion.so/profile/integrations/internal
# Then in Notion, share the Briefs database (and any page Hivemind touches)
# with the integration via "..." → Connections → <your integration name>.
NOTION_API_TOKEN=

# ── Anthropic ────────────────────────────────────────────────────────────────
# Create at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ── Hivemind config ──────────────────────────────────────────────────────────
# Briefs database ID — populated after the database is created in Notion.
# Get the ID from the database URL: notion.so/<space>/<DB_ID>?v=...
HIVEMIND_BRIEFS_DATABASE_ID=

# Shared secret you put in the Notion automation's webhook "Headers" field as
# `X-Hivemind-Secret: <this>`. The Worker verifies this on every incoming POST.
HIVEMIND_WEBHOOK_SECRET=
